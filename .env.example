# Copy to .env and fill in. Never commit .env.
# scripts/deploy.sh reads this file as a shell script (". ./.env"), so quote any value that contains
# spaces or < > (e.g. MAIL_FROM="PBAT DOOR TO DOOR <no-reply@pbatdoor2door2027.org>",
# ZOHO_WA_TOKEN="Zoho-enczapikey …"); unquoted, the deploy fails or the value is cut short. Avoid "$".

# ---- Core ----
# production on the server. For local testing, development shows sign-in codes on screen
# and enables phone sign-in with codes in the log (never use development on the server).
NODE_ENV=production
APP_NAME="PBAT DOOR TO DOOR"
# Runs Caddy (HTTPS) and the nightly backup service. Leave empty for local development.
COMPOSE_PROFILES=prod

# ---- Domain / HTTPS (Caddy) ----
SITE_DOMAIN=pbatdoor2door2027.org
# Let's Encrypt contact for certificate expiry notices.
ACME_EMAIL=
# direct (Cloudflare "DNS only", recommended) or cloudflare (Cloudflare proxy / orange cloud).
PROXY_MODE=direct

# ---- Database (the compose `db` service) ----
POSTGRES_DB=pbat
POSTGRES_USER=pbat
# Long random value, e.g. from: openssl rand -hex 32   (only applied when the volume is first created)
POSTGRES_PASSWORD=

# ---- Backups ----
BACKUP_DIR=/opt/pbatdoor2door/backups
# Owner of the backup files: user1's ids (check with: id -u user1; id -g user1)
BACKUP_UID=1000
BACKUP_GID=1000
BACKUP_TIME_UTC=01:30
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_WEEKLY=8

# ---- Email: the first one that is set is used (Brevo recommended; Linode blocks SMTP) ----
# Sender, e.g. "PBAT DOOR TO DOOR <no-reply@pbatdoor2door2027.org>"
MAIL_FROM=
BREVO_API_KEY=
# Zoho ZeptoMail "Send Mail token" (with or without the "Zoho-enczapikey " prefix).
ZEPTOMAIL_TOKEN=
# ZEPTOMAIL_API_URL=https://api.zeptomail.eu/v1.1/email   # only for EU-hosted Zoho accounts
RESEND_API_KEY=
GMAIL_SCRIPT_URL=
GMAIL_SCRIPT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---- Phone sign-in: Google Firebase (browser-side codes) ----
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_SDK_URL=
# FIREBASE_JWKS_URL=

# ---- Phone sign-in: server-side providers (first one set wins) ----
# Zoho CPaaS (same Zoho account as ZeptoMail; README section 4 "Phone sign-in with Zoho CPaaS").
# Zoho has no SMS for Nigeria, so codes go by WhatsApp, with an automated voice call as fallback.
# Each channel of a Zoho Agent has its OWN key (Agents > agent > SMTP/API): ZEPTOMAIL_TOKEN won't work here.
# WhatsApp: needs all three. Sender = the WhatsApp Business number connected in Zoho, with country code.
# Template = the approved Authentication template's key (uuid) or alias. Quote values with spaces.
ZOHO_WA_TOKEN=
ZOHO_WA_FROM=
ZOHO_WA_TEMPLATE=
# Name of the template variable that holds the code (as shown in the Zoho template editor).
# ZOHO_WA_CODE_VAR=code
# Voice (optional fallback and "Call me with the code"): the Agent's Voice key and a Zoho Voice number.
ZOHO_VOICE_TOKEN=
ZOHO_VOICE_FROM=
# Leave empty to speak the code with text-to-speech, or a voice template key/alias with a {{code}} merge tag.
# ZOHO_VOICE_TEMPLATE=
# ZOHO_VOICE_CODE_VAR=code
# ZOHO_VOICE_LANGUAGE=en
# Only if your Zoho CPaaS account's API docs show a different address (other data centre).
# ZOHO_CPAAS_API_URL=https://cpaas.zoho.com/v1.1
# Message Central VerifyNow
MC_CUSTOMER_ID=
MC_PASSWORD=
# MC_KEY=
# MC_FLOW=SMS
# MC_EMAIL=
# MC_BASE_URL=
# DageSMS
DAGESMS_API_KEY=
# DAGESMS_SENDER=
# DAGESMS_ROUTE=corporate
# DAGESMS_BASE_URL=
# Termii
TERMII_API_KEY=
TERMII_SENDER_ID=
# TERMII_CHANNEL=dnd
# TERMII_BASE_URL=
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---- Optional Cloudflare Turnstile (bot check on code requests) ----
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ---- Advanced (defaults are right for this setup) ----
# OTP_IP_LIMIT_PER_HOUR=10
# Codes one phone number can be sent per day, sign-in and linking together (controls WhatsApp/call cost).
# OTP_PHONE_LIMIT_PER_DAY=5
# Re-issue the session cookie this often (ms). Default 1 day. Sessions themselves never expire.
# SESSION_REFRESH_MS=86400000
# TRUST_PROXY=1
# CSP_MODE=enforce            # enforce | report-only | off
# LOG_LEVEL=info
# MIGRATE_ON_START=true
# APP_PORT=3000
# PG_SHARED_BUFFERS=128MB
# DATABASE_POOL_MAX=10
